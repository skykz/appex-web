# Local: default in code is http://localhost:3000/api when unset in dev.
# Vercel (frontend project): required — backend origin or full /api base (origin-only is auto-fixed to …/api).
# Example: VITE_API_URL=https://appex-web-backend-taupe.vercel.app
VITE_API_URL=http://localhost:3000/api
# Public URL of this learner SPA (frontend Vercel project). Local dev can leave empty.
# Must match backend APP_URL. Do not use the USA landing URL here.
# VITE_APP_ORIGIN=https://appex-web.vercel.app
# Password reset: backend APP_PUBLIC_URL should match this origin; Supabase Auth → URL Configuration must allow …/auth/reset-password
# If the SPA is hosted at https://appex.kz/app/ set base path (must end with / for build). Dev: open http://localhost:5173/app/
# VITE_BASE_PATH=/app/
