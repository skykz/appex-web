# Local: default in code is http://localhost:3000/api when unset in dev.
# Vercel (frontend project): required — backend origin or full /api base (origin-only is auto-fixed to …/api).
# Example: VITE_API_URL=https://appex-web-backend-taupe.vercel.app
VITE_API_URL=http://localhost:3000/api
# Public URL where this SPA is served (landings link here). Local dev can leave empty.
# VITE_APP_ORIGIN=https://appex-web-frontend.vercel.app
# If the SPA is hosted at https://appex.kz/app/ set base path (must end with / for build). Dev: open http://localhost:5173/app/
# VITE_BASE_PATH=/app/
