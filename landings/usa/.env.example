# Backend API URL — origin or …/api both work (same as frontend/admin).
# Example: https://appex-web-backend-taupe.vercel.app/api
VITE_API_URL=http://localhost:3000

# Learner SPA URL (frontend Vercel project). Must match backend APP_URL.
# Used to forward Stripe /settings returns from this landing to the course platform.
# VITE_APP_URL=http://localhost:5173
# VITE_APP_URL=https://appex-web.vercel.app

# --- Meta Pixel (ads funnel tracking) ---
# Pixel id from Meta Events Manager. When unset, all pixel tracking is a safe
# no-op (funnel keeps working). Must match backend META_PIXEL_ID.
# VITE_META_PIXEL_ID=1234567890
# Optional: routes browser events to the Events Manager "Test Events" stream.
# VITE_META_TEST_EVENT_CODE=TEST12345

# --- GA4 analytics (parallel funnel tracking, gtag.js) ---
# Sends to the "Appex Landing" stream G-9VSNWFGHR6, baked into src/lib/ga4.ts —
# no env var needed. Override the stream with VITE_GA4_MEASUREMENT_ID if needed.
# The backend Measurement Protocol purchase needs GA4_API_SECRET on the backend.
# VITE_GA4_MEASUREMENT_ID=G-9VSNWFGHR6   # optional override
# Set to "true" to let GA4 fire in DEV builds (routes to GA4 DebugView).
# VITE_GA4_DEBUG=false
