# Server
PORT=3000

# Supabase — Project Settings → API
SUPABASE_URL=https://YOUR_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: TCP connect to Supabase (default 60000 ms)
# SUPABASE_CONNECT_TIMEOUT_MS=60000

# Landings + every SPA origin that calls this API (comma-separated). Required on Vercel when set.
# Missing an origin here → that SPA fails CORS preflight (no Access-Control-Allow-Origin).
# CORS_ORIGINS=https://app.appexme.com,https://appexme.com,https://www.appexme.com,http://localhost:5173,http://localhost:5174,http://localhost:5175
# Optional: add admin (or previews) without editing the long line above:
# CORS_ORIGINS_EXTRA=https://appex-web-admin.vercel.app

# USA marketing landing URL — Stripe success/cancel for payment-first checkout.
# In production (Vercel) this DEFAULTS to https://appexme.com, so you only need to
# set it to override (e.g. a preview domain). Locally it defaults to localhost:5175.
# USA_LANDING_URL=http://localhost:5175
# USA_LANDING_URL=https://appexme.com

# Learner app URL for magic links, password reset redirects, and email CTAs.
# Password reset emails are sent via Mailgun (not Supabase); the link still uses Supabase recovery tokens.
# On Vercel production set BOTH to your live learner SPA (same value is fine).
# APP_PUBLIC_URL=https://app.appexme.com
# Add these to Supabase → Authentication → URL Configuration → Redirect URLs:
#   https://app.appexme.com/auth/callback
#   https://app.appexme.com/auth/reset-password
# ADMIN_APP_PUBLIC_URL=https://your-admin-app.vercel.app

# --- AI providers (optional). If none are set, chat uses built-in mock replies for every model.
# Powers BOTH the chat model catalog and Lexi (the in-course mentor).
# Without it, Lexi serves a canned demo reply in dev and returns 503 in production.
# OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-4o        # also used as Lexi's model
# OPENAI_FAST_MODEL=gpt-4o-mini
# Anthropic is disabled project-wide (see services/ai.service.ts). To restore:
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# DEEPSEEK_API_KEY=...
# DEEPSEEK_MODEL=deepseek-chat
# PERPLEXITY_API_KEY=pplx-...
# PERPLEXITY_MODEL=sonar

# --- Stripe (subscription billing)
# Learner SPA URL (frontend Vercel project) — NOT the USA marketing landing URL.
# Stripe Checkout success/cancel and Customer Portal return URLs are built from this.
# In production (Vercel) this DEFAULTS to https://app.appexme.com — set it only to
# override. Locally it defaults to http://localhost:5173.
# Local dev:
APP_URL=http://localhost:5173
# Vercel production (must match APP_PUBLIC_URL for email links to work):
# APP_URL=https://app.appexme.com

# Stripe — Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# Stripe — Dashboard → Developers → Webhooks → signing secret (or `stripe listen` output)
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe price IDs — Dashboard → Products → AppEx Premium
STRIPE_PRICE_1WEEK=price_...
STRIPE_PRICE_4WEEK=price_...
STRIPE_PRICE_YEARLY=price_...
# USA paywall intro coupons (duration=once, fixed amount off).
# 4 Weeks $38.95→$15.19 · Annual $127→$49
#
# 1 Week $38.95→$6.93 (coupon AFcqsZB8, -$32.02). Note the base: the 1-week plan
# is billed on the 4-WEEK price ($38.95), not $17.77 — the paywall's "1 week"
# option is a cheaper first payment on the same 4-week subscription. A coupon
# sized against $17.77 (e.g. the old -$10.84) leaves the customer paying ~$28
# today instead of $6.93, and nothing errors.
STRIPE_INTRO_COUPON_1WEEK=
STRIPE_INTRO_COUPON_4WEEK=
STRIPE_INTRO_COUPON_YEAR=
# Legacy fallback for 4-week intro
STRIPE_INTRO_COUPON_ID=
# USA paywall exit-intent coupons (duration=once, deeper discount than intro).
# 4 Weeks $38.95→$11.29 · Annual $127→$36.83
# 1 Week $38.95→$5.15 (coupon Ypd3rTNT, -$33.80) — same 4-week base as above.
# If a plan is left blank, that plan's exit checkout falls back to its intro coupon.
STRIPE_EXIT_COUPON_1WEEK=
STRIPE_EXIT_COUPON_4WEEK=
STRIPE_EXIT_COUPON_YEAR=

# Where billing alerts needing a human are emailed. Currently fires when a
# "1 Week" purchase can't be converted to the 4-week price and would otherwise
# keep billing weekly at full price. Alerts are always written to the
# billing_alerts table; this only controls the email notification.
BILLING_ALERT_EMAIL=

# --- Mailgun (E1 payment success, E2 welcome, password reset, E3 3-day renewal, E4 cancellation, E5 24h renewal, E6 reengagement, E7 payment confirmed)
#
# PRODUCTION (appexme.com — verify domain in Mailgun, Dayan adds DNS records):
# MAILGUN_API_KEY=key-...
# MAILGUN_DOMAIN=appexme.com
# MAILGUN_FROM=Appex <hello@appexme.com>
# MAILGUN_REPLY_TO=hello@appexme.com
#
# LOCAL / SANDBOX (testing only — authorized recipients only):
# MAILGUN_DOMAIN=sandboxXXXX.mailgun.org
# MAILGUN_FROM=Appex <postmaster@sandboxXXXX.mailgun.org>
#
# Optional deliverability / compliance:
# MAILGUN_COMPANY_NAME=Appex
# MAILGUN_PHYSICAL_ADDRESS=Your legal US mailing address
# MAILGUN_WEBHOOK_SIGNING_KEY=...   # Mailgun → Webhooks → https://<api>/api/mailgun/webhook
# MAILGUN_EU_REGION=false
# MAILGUN_REQUIRE_PRODUCTION_DOMAIN=true   # on Vercel — blocks sandbox domain
#
# E3 renewal cron (Vercel runs daily; set same value in Vercel → Environment Variables)
# CRON_SECRET=generate-a-long-random-string

# --- Lead magnet: "AI Agents Guidebook" promised on the quiz email step ---
# Public download URL for the guidebook. This doubles as the feature flag: while it
# is unset, NO guidebook email is sent to quiz leads (a "here's your guidebook" mail
# with nothing behind it is worse than silence). Set it in Vercel to switch the lead
# magnet on — no deploy needed. Requires MAILGUN_* to be configured as well.
# LEAD_GUIDEBOOK_URL=https://appexme.com/downloads/ai-agents-guidebook.pdf

# --- Meta Conversions API (server-side Purchase for the ads funnel) ---
# Same pixel id as the USA landing's VITE_META_PIXEL_ID. When both of these are
# unset the server-side Purchase event is a safe no-op (payment still provisions).
# META_PIXEL_ID=1234567890
# Events Manager → Data Sources → your pixel → Settings → Conversions API token
# META_CAPI_ACCESS_TOKEN=EAAG...
# Optional: routes CAPI events to the Events Manager "Test Events" stream
# META_TEST_EVENT_CODE=TEST12345

# --- GA4 Measurement Protocol (server-side purchase for the ads funnel) ---
# GA4_MEASUREMENT_ID defaults to the "Appex Landing" stream (G-9VSNWFGHR6) — no
# need to set it. The server-side GA4 purchase stays a safe no-op until you set
# GA4_API_SECRET below (the ONLY thing needed to turn it on).
# GA4_MEASUREMENT_ID=G-9VSNWFGHR6   # optional override
# GA4 Admin → Data Streams → your stream → Measurement Protocol API secrets → Create
# GA4_API_SECRET=...

# --- Local file logging (JSONL) ---
# Writes logs/<timestamp>/<domain>.jsonl for offline analysis.
# Defaults to ON outside production; never enable on Vercel (read-only FS).
# LOG_TO_FILE=true
# Override the log directory (default: <cwd>/logs)
# LOG_DIR=./logs
