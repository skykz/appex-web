# Server
PORT=3000

# Supabase — Project Settings → API
SUPABASE_URL=https://YOUR_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: TCP connect to Supabase (default 60000 ms)
# SUPABASE_CONNECT_TIMEOUT_MS=60000

# Landings (appex.kz) + React app origin — required in production so the browser can call this API
# CORS_ORIGINS=https://appex.kz,https://www.appex.kz,https://appex-web-frontend.vercel.app,http://localhost:5173
