# Server
PORT=3000

# Supabase — Project Settings → API
SUPABASE_URL=https://YOUR_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: TCP connect to Supabase (default 60000 ms)
# SUPABASE_CONNECT_TIMEOUT_MS=60000

# Landings + every SPA origin that calls this API (comma-separated). Required on Vercel when set.
# Missing https://appex-web-admin.vercel.app → admin login fails CORS preflight (no Access-Control-Allow-Origin).
# CORS_ORIGINS=https://appex.kz,https://www.appex.kz,https://appex-web.vercel.app,https://your-usa-landing.vercel.app,http://localhost:5173,http://localhost:5174,http://localhost:5175
# Optional: add admin (or previews) without editing the long line above:
# CORS_ORIGINS_EXTRA=https://appex-web-admin.vercel.app

# USA marketing landing URL — Stripe success/cancel for payment-first checkout.
# USA_LANDING_URL=http://localhost:5175
# USA_LANDING_URL=https://your-usa-landing.vercel.app

# Learner app URL for magic links, password reset redirects, and email CTAs.
# Password reset emails are sent via Mailgun (not Supabase); the link still uses Supabase recovery tokens.
# On Vercel production set BOTH to your live learner SPA (same value is fine).
# APP_PUBLIC_URL=https://appex-web.vercel.app
# Add these to Supabase → Authentication → URL Configuration → Redirect URLs:
#   https://<learner-app>/auth/callback
#   https://<learner-app>/auth/reset-password
# ADMIN_APP_PUBLIC_URL=https://your-admin-app.vercel.app

# --- AI providers (optional). If none are set, chat uses built-in mock replies for every model.
# OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-4o
# OPENAI_FAST_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# DEEPSEEK_API_KEY=...
# DEEPSEEK_MODEL=deepseek-chat
# PERPLEXITY_API_KEY=pplx-...
# PERPLEXITY_MODEL=sonar

# --- Stripe (subscription billing)
# Learner SPA URL (frontend Vercel project) — NOT the USA marketing landing URL.
# Stripe Checkout success/cancel and Customer Portal return URLs are built from this.
# Local dev:
APP_URL=http://localhost:5173
# Vercel production (must match APP_PUBLIC_URL for email links to work):
# APP_URL=https://appex-web.vercel.app

# Stripe — Dashboard → Developers → API keys
STRIPE_SECRET_KEY=mk_1Sw2fXEqQKJabAHvykKY
# Stripe — Dashboard → Developers → Webhooks → signing secret (or `stripe listen` output)
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe price IDs — Dashboard → Products → AppEx Premium
STRIPE_PRICE_1WEEK=price_...
STRIPE_PRICE_4WEEK=price_...
STRIPE_PRICE_YEARLY=price_...
# USA paywall intro coupons (duration=once, amount off renewal price)
STRIPE_INTRO_COUPON_1WEEK=
STRIPE_INTRO_COUPON_4WEEK=
STRIPE_INTRO_COUPON_YEAR=
# Legacy fallback for 4-week intro
STRIPE_INTRO_COUPON_ID=

# --- Mailgun (E1 payment success, E2 welcome, password reset, E3 3-day renewal, E4 cancellation, E5 24h renewal, E6 reengagement, E7 payment confirmed)
#
# PRODUCTION (appexme.com — verify domain in Mailgun, Dayan adds DNS records):
# MAILGUN_API_KEY=key-...
# MAILGUN_DOMAIN=appexme.com
# MAILGUN_FROM=Appex <hello@appexme.com>
# MAILGUN_REPLY_TO=hello@appexme.com
#
# LOCAL / SANDBOX (testing only — authorized recipients only):
# MAILGUN_DOMAIN=sandboxXXXX.mailgun.org
# MAILGUN_FROM=Appex <postmaster@sandboxXXXX.mailgun.org>
#
# Optional deliverability / compliance:
# MAILGUN_COMPANY_NAME=Appex
# MAILGUN_PHYSICAL_ADDRESS=Your legal US mailing address
# MAILGUN_WEBHOOK_SIGNING_KEY=...   # Mailgun → Webhooks → https://<api>/api/mailgun/webhook
# MAILGUN_EU_REGION=false
# MAILGUN_REQUIRE_PRODUCTION_DOMAIN=true   # on Vercel — blocks sandbox domain
#
# E3 renewal cron (Vercel runs daily; set same value in Vercel → Environment Variables)
# CRON_SECRET=generate-a-long-random-string
