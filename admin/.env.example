# Local dev: API must be running on this host (default backend PORT=3000).
# Easiest: from repo root `appex-web` run: npm run dev:admin-stack  (starts backend + admin).
# If this line is missing, Vite dev still uses http://localhost:3000/api by default.
VITE_API_URL=http://localhost:3000/api

# Production (Vercel admin build): set to your deployed API, e.g.:
# VITE_API_URL=https://appex-web-backend-taupe.vercel.app/api
