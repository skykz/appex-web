# Required for production builds (Vercel, etc.). Omit only for local `npm run dev` (defaults to localhost API).
# Backend is mounted at /api — you may use either full base or origin only (origin is auto-fixed to …/api):
# VITE_API_URL=https://appex-web-backend-taupe.vercel.app
# VITE_API_URL=https://appex-web-backend-taupe.vercel.app/api
VITE_API_URL=http://localhost:3000/api
